{
  "name": "tina-standalone",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "TINA_PUBLIC_IS_LOCAL=true tinacms dev --verbose -c \"next dev\"",
    "dev:prod": "TINA_PUBLIC_IS_LOCAL=false tinacms dev -c \"next dev\"",
    "build": "tinacms build --partial-reindex && tsc && netlify build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@tinacms/datalayer": "^1.3.16",
    "netlify-cli": "^15.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tinacms": "^2.2.1",
    "tinacms-authjs": "^10.0.5",
    "tinacms-gitprovider-github": "^2.0.1",
    "upstash-redis-level": "^1.1.1",
    "wrangler": "^3.4.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.10.7",
    "@tinacms/cli": "^1.6.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react-swc": "^3.3.2",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "typescript": "^5.0.2"
  }
}
